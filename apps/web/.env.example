# Causal web — copy to .env.local for local dev.

# API base URL. Leave unset to run the demo entirely on mock data (recommended
# for the public demo — the UI falls back to mock on any API failure).
NEXT_PUBLIC_API_URL=http://localhost:3001

# Bearer key sent to the API. The public demo key works with zero seeding.
NEXT_PUBLIC_CAUSAL_API_KEY=causal_demo_key_2026

# Force the mock demo (never hit the API). Set to 1 on the deployed demo.
# NEXT_PUBLIC_DEMO_MODE=1

# Flip the incident explorer to LIVE traces from /api/v1/traces (falls back to
# mock on any error). Requires the API running + seeded (pnpm db:seed-traces).
# NEXT_PUBLIC_USE_LIVE_TRACES=1
