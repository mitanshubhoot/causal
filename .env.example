# Causal — environment template. Copy to .env and edit.
#
# Every variable below is read by code in this repo; nothing here is decorative.
# All of them have working defaults for local dev except where marked REQUIRED,
# so `cp .env.example .env && pnpm infra:up` is enough to boot.
#
# NOTE: apps/web reads NEXT_PUBLIC_* at build time from apps/web/.env.local, not
# from this file. See the "Web app" section at the bottom.

# ── Core services (docker-compose.yml) ────────────────────────────
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=causal_dev_password

# docker-compose publishes Postgres on host port 5433 (→ container 5432). The
# API, migrate.js and the seed scripts all default to 5433 — keep them aligned.
# This single URL is the only Postgres var the code reads.
POSTGRES_URL=postgresql://causal:causal_dev_password@localhost:5433/causal

REDIS_URL=redis://localhost:6379

# ── Object storage (S3-compatible: AWS S3, Cloudflare R2, or MinIO) ─
# Holds context snapshots. Unset → the defaults below point at local MinIO.
S3_BUCKET=causal-snapshots
S3_REGION=us-east-1
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin

# ── API server ────────────────────────────────────────────────────
NODE_ENV=development
API_PORT=3001
API_HOST=0.0.0.0
# Where the API reaches the Python RCA service (apps/rca).
RCA_SERVICE_URL=http://localhost:8001
# Allowed CORS origin(s); comma-separated for more than one, e.g.
# APP_URL=http://localhost:3000,https://causal-demo.vercel.app
APP_URL=http://localhost:3000
# Allow the public demo key (causal_demo_key_2026) in production, read-only.
# Unset → the demo key is rejected when NODE_ENV=production. Leave unset in
# real deploys.
ALLOW_DEMO_KEY=

# ── RCA service (apps/rca) ────────────────────────────────────────
# Port the Python RCA service listens on. Must match RCA_SERVICE_URL above.
RCA_PORT=8001

# ── Secrets at rest ───────────────────────────────────────────────
# AES-256-GCM key encrypting customer-supplied provider keys (BYOK) in the
# provider_keys table. Must decode to exactly 32 bytes: base64 (44 chars) or
# hex (64 chars). Generate with: openssl rand -base64 32
# Unset → every BYOK read/write 503s with a clear message and the server-wide
# provider keys below are used instead.
CAUSAL_ENCRYPTION_KEY=

# ── Model providers (server-wide fallback keys) ───────────────────
# Per-workspace BYOK keys live in provider_keys and take precedence; these are
# only used when an org has not stored its own. Every provider is optional —
# with none set, detectors/RCA/copilot degrade instead of failing.
# A value containing "your-", "xxx", or starting with "sk-ant-..." is treated
# as NOT set, so the placeholders below are safe to leave in place.
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=
# GEMINI_API_KEY is accepted as an alias.
GOOGLE_API_KEY=
XAI_API_KEY=
DEEPSEEK_API_KEY=
OPENROUTER_API_KEY=
MOONSHOT_API_KEY=
# ZHIPUAI_API_KEY is accepted as an alias. Format: <id>.<secret>
ZHIPU_API_KEY=
# AWS Bedrock — needs both id and secret; session token is optional.
# Region falls back to AWS_DEFAULT_REGION, then S3_REGION, then us-east-1.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
AWS_REGION=
# Any provider's endpoint can be overridden with <PROVIDER>_BASE_URL, e.g.
# OPENAI_BASE_URL=https://my-gateway.internal/v1

# ── Model selection ───────────────────────────────────────────────
# Per-purpose model ids. A workspace can override these in org_llm_settings.
DETECTOR_MODEL=claude-haiku-4-5
RCA_MODEL=claude-sonnet-4-5
COPILOT_MODEL=claude-sonnet-4-5

# ── Feature flags ─────────────────────────────────────────────────
# Accepts 1/true/yes/on. Anything else (including "false") is off.
ENABLE_VECTOR_EMBEDDINGS=false
ENABLE_SLACK_NOTIFICATIONS=true
# Minimum edge confidence before a causal link is shown as established.
MIN_CONFIDENCE_THRESHOLD=0.5
# Run the LLM-as-judge detector inline on trace ingest (fire-and-forget).
ENABLE_DETECTORS=false
# Auto-run RCA and propose a fix when a detector fires.
ENABLE_AUTO_RCA=false

# ── Fix verification sandbox ──────────────────────────────────────
# Clones the repo and actually runs its tests before a fix is called verified.
# Off by default because it executes repository code. Also requires the GitHub
# App credentials below — without them it stays disabled.
SANDBOX_ENABLED=false
# Working directory for clones. Empty → <tmpdir>/causal-sandboxes.
SANDBOX_ROOT=
# Per-command timeout in milliseconds.
SANDBOX_TIMEOUT_MS=120000

# ── GitHub App (CODE nodes, PR creation, sandbox clones) ──────────
# Unset → push webhooks are accepted without signature verification and the
# API cannot open pull requests.
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=

# ── Webhook signing secrets ───────────────────────────────────────
# Each is optional; unset → that source's payloads are accepted unverified.
# Set every one you actually expose to the internet.
PAGERDUTY_WEBHOOK_SECRET=
SENTRY_WEBHOOK_SECRET=
DATADOG_WEBHOOK_SECRET=
LINEAR_WEBHOOK_SECRET=
LANGSMITH_WEBHOOK_SECRET=

# ── Slack ─────────────────────────────────────────────────────────
# Unset → Slack notifications are skipped regardless of the flag above.
SLACK_BOT_TOKEN=
# Channel id for detector alerts.
SLACK_INCIDENT_CHANNEL=

# ── Email alerts (set ONE provider key plus a recipient) ──────────
# No key or no recipient → alert emails are skipped silently.
RESEND_API_KEY=
SENDGRID_API_KEY=
ALERT_EMAIL_TO=
ALERT_EMAIL_FROM=alerts@causal.dev

# ── Web app (apps/web) ────────────────────────────────────────────
# These belong in apps/web/.env.local — Next.js inlines NEXT_PUBLIC_* at build
# time and does not read this file. Without them the UI silently serves mock
# fixtures, which look exactly like real data.
#
# Server-side proxy target for the /api/v1 rewrite in next.config.mjs.
CAUSAL_API_URL=http://localhost:3001
# Unset → NEXT_PUBLIC_DEMO_MODE defaults ON and nothing hits the API.
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_CAUSAL_API_KEY=causal_demo_key_2026
# Set to 1 to force the mock-data demo. Also defaults ON whenever
# NEXT_PUBLIC_API_URL is unset.
NEXT_PUBLIC_DEMO_MODE=
# Set to 1 to load the trace explorer from the live API instead of the mock.
NEXT_PUBLIC_USE_LIVE_TRACES=
# Absolute site URL — used for OpenGraph/Twitter card metadata.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── SDK / CLI (set these in YOUR instrumented app, not the server) ─
CAUSAL_API_KEY=causal_demo_key_2026
CAUSAL_ORG_ID=org_demo_causal_001
# Ties spans to a repository so RCA can blame a commit rather than a time window.
CAUSAL_REPO_ID=
# Overrides the HEAD sha the CLI resolves — useful in detached-HEAD CI checkouts.
CAUSAL_GIT_COMMIT=

# ── Exporting from a standard OpenTelemetry SDK ───────────────────
# Causal accepts OTLP/HTTP JSON at /v1/traces, so any OTel SDK can export to it
# without the Causal SDK. Set these in YOUR instrumented app:
#   OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:3001
#   OTEL_EXPORTER_OTLP_PROTOCOL=http/json
#   OTEL_EXPORTER_OTLP_HEADERS="authorization=Bearer causal_demo_key_2026"
# gen_ai.* semantic-convention attributes (tokens, model, prompt/completion) are
# mapped automatically, as are code.filepath / code.lineno for git context.
