# ── Database ──────────────────────────────────────────────────────
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=causal_dev_password

# NOTE: docker-compose publishes Postgres on host port 5433 (→ container 5432).
# The API, seed script, and migrate.js all default to 5433 — keep them aligned.
POSTGRES_URL=postgresql://causal:causal_dev_password@localhost:5433/causal
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_DB=causal
POSTGRES_USER=causal
POSTGRES_PASSWORD=causal_dev_password

REDIS_URL=redis://localhost:6379

# ── Object Storage ────────────────────────────────────────────────
# Use S3-compatible: AWS S3, Cloudflare R2, or MinIO (local dev)
S3_BUCKET=causal-snapshots
S3_REGION=auto
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin

# ── LLM APIs ─────────────────────────────────────────────────────
# Leave ANTHROPIC_API_KEY empty (or as the placeholder) to run replay /
# post-mortem in demo mode without calling Claude.
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...

# ── Integrations (webhook secrets — leave blank to skip verification) ─
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=
PAGERDUTY_WEBHOOK_SECRET=
SENTRY_WEBHOOK_SECRET=
DATADOG_WEBHOOK_SECRET=
LINEAR_WEBHOOK_SECRET=
LANGSMITH_WEBHOOK_SECRET=
SLACK_BOT_TOKEN=xoxb-...
SLACK_SIGNING_SECRET=
SLACK_INCIDENT_CHANNEL=

# ── App / API ─────────────────────────────────────────────────────
API_PORT=3001
API_HOST=0.0.0.0
RCA_SERVICE_URL=http://localhost:8001
APP_URL=http://localhost:3000
# Comma-separated list of allowed CORS origins is supported, e.g.
# APP_URL=http://localhost:3000,https://causal-demo.vercel.app

# ── Web app (Next.js — NEXT_PUBLIC_* are exposed to the browser) ───
# Server-side proxy target for the /api/v1 rewrite in next.config.mjs.
CAUSAL_API_URL=http://localhost:3001
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_CAUSAL_API_KEY=causal_demo_key_2026
# Set to 1 to force the mock-data demo (never calls the API). Also defaults ON
# whenever NEXT_PUBLIC_API_URL is unset.
NEXT_PUBLIC_DEMO_MODE=
# Absolute site URL — used for OpenGraph/Twitter card metadata.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Feature flags ─────────────────────────────────────────────────
ENABLE_VECTOR_EMBEDDINGS=false
ENABLE_SLACK_NOTIFICATIONS=true
MIN_CONFIDENCE_THRESHOLD=0.5

# ── v2 observability: detectors + agentic RCA ─────────────────────
# Run the LLM-as-judge detector inline on trace ingest (fire-and-forget).
ENABLE_DETECTORS=false
# Auto-run RCA + propose a fix when a detector fires.
ENABLE_AUTO_RCA=false
DETECTOR_MODEL=claude-haiku-4-5
RCA_MODEL=claude-sonnet-4-5
# Slack channel id for detector alerts (optional).
SLACK_INCIDENT_CHANNEL=
COPILOT_MODEL=claude-sonnet-4-5

# ── Email alerts (set ONE provider key + a recipient) ──────────────
RESEND_API_KEY=
SENDGRID_API_KEY=
ALERT_EMAIL_TO=
ALERT_EMAIL_FROM=alerts@causal.dev

# Allow the public demo key in production (read-only). Leave unset in real deploys.
ALLOW_DEMO_KEY=
